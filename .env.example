# Pick2Buy Environment Variables Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pick2buy?schema=public"

# Authentication
JWT_SECRET=super_secret_pick2buy_jwt_access_key_change_in_production_2026
JWT_REFRESH_SECRET=super_secret_pick2buy_jwt_refresh_key_change_in_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=rzp_test_pick2buy_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_pick2buy_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Email System (Pick2Buy)
# Pick2Buy Official Contact: pick2buy.in@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=pick2buy.in@gmail.com
SMTP_PASSWORD=your_app_specific_password_here
EMAIL_FROM="Pick2Buy India <pick2buy.in@gmail.com>"

# Cloud Storage / Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=pick2buy_cloud
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Services (Shipping APIs, e.g. Shiprocket)
SHIPROCKET_EMAIL=pick2buy.in@gmail.com
SHIPROCKET_PASSWORD=shiprocket_password
