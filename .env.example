# Pick2Buy Environment Variables Configuration
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Database (PostgreSQL)
DATABASE_URL="postgresql://your_database_user:your_database_password@your_database_host:5432/your_database_name?schema=public"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="server-only-service-role-key"
SUPABASE_PRODUCT_IMAGE_BUCKET="product-images"

# Authentication
JWT_SECRET=your_long_random_jwt_access_secret
JWT_REFRESH_SECRET=your_long_random_jwt_refresh_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google Identity Services: use the same Web client ID in both places.
# Add your storefront origin (including port in development) as an authorized JavaScript origin.
GOOGLE_CLIENT_ID=
# Set the same value as VITE_GOOGLE_CLIENT_ID in frontend/.env.local or the frontend deployment environment.

# Payment Gateways (Razorpay)
RAZORPAY_KEY_ID=rzp_test_pick2buy_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_pick2buy_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# Email System (Pick2Buy)
# Required for email/password sign-in and sign-up OTP. Gmail needs a Google App Password
# on an account with 2-Step Verification; a normal account password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email_address@example.com
SMTP_PASSWORD=your_app_specific_password_here
EMAIL_FROM="Your Store <no-reply@example.com>"

# Cloud Storage / Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional Services (Shipping APIs, e.g. Shiprocket)
SHIPROCKET_EMAIL=your_shipping_account_email@example.com
SHIPROCKET_PASSWORD=your_shipping_account_password
