{
  "name": "@pick2buy/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "node scripts/prisma-postgres.cjs generate",
    "db:deploy": "node scripts/prisma-postgres.cjs migrate deploy",
    "db:sqlite:generate": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:sqlite:push": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:categories": "tsx src/database/seedCategories.ts",
    "db:seed": "tsx src/database/seed.ts",
    "db:setup": "npm run db:generate && npm run db:deploy",
    "test": "npm run build && node scripts/run-tests.cjs"
  },
  "dependencies": {
    "@pick2buy/shared": "*",
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.16",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "@types/nodemailer": "^8.0.2",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
